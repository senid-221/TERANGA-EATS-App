# TerangaEats production payment configuration
# Keep real secrets only in Hostinger environment variables, never in Git.

# Wave Checkout API (Senegal)
WAVE_API_KEY=
WAVE_API_BASE_URL=https://api.wave.com
WAVE_PAYMENT_ENDPOINT=/v1/checkout/sessions
WAVE_WEBHOOK_SECRET=

# Orange Money Web Payment (Senegal)
# Obtain merchant credentials/access from Orange Developer / local Orange Money team.
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_API_BASE_URL=https://api.orange.com
ORANGE_MONEY_PAYMENT_ENDPOINT=
ORANGE_MONEY_WEBHOOK_SECRET=

# Public HTTPS origin used for payment success/error callbacks
PUBLIC_APP_URL=https://citymarketbusiness.com
