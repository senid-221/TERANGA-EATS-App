# TerangaEats production environment variables
# IMPORTANT: Put the real values in Hostinger Environment Variables / .env on the server.
# Never commit real API keys, passwords, or service-role secrets to GitHub.

APP_URL="https://citymarketbusiness.com"

# OpenRouter AI — SERVER ONLY
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"
OPENROUTER_MODEL="openai/gpt-chat-latest"

# Google Maps — browser-safe restricted key
VITE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# Admin server-cookie authentication — SERVER ONLY
ADMIN_EMAIL="rw@akaziconnect.com"
ADMIN_PASSWORD="YOUR_ADMIN_PASSWORD"
ADMIN_SESSION_SECRET="YOUR_LONG_RANDOM_SESSION_SECRET"

# Supabase client — browser-safe anon/publishable key
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Supabase server — SECRET, never prefix with VITE_
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# WasenderAPI WhatsApp — SERVER ONLY
WASENDER_API_KEY="YOUR_WASENDER_API_KEY"
WASENDER_ADMIN_NUMBER="+250726969060"
WASENDER_WEBHOOK_SECRET="YOUR_WASENDER_WEBHOOK_SECRET"
WASENDER_API_URL="https://www.wasenderapi.com"
