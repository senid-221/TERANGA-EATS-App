# GEMINI_API_KEY: Required for Gemini AI API calls.
# Keep private; never expose server-only secrets with the VITE_ prefix.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted.
APP_URL="https://citymarketbusiness.com"

# Google Maps Platform API key used by the client UI.
VITE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# Clerk Authentication
# Publishable key for the Clerk development instance.
VITE_CLERK_PUBLISHABLE_KEY="pk_test_cHJlbWl1bS1uYXJ3aGFsLTk1Ny5jbGVyay5hY2NvdW50cy5kZXYk"

# Comma-separated email allowlist for the initial admin gate.
# Production authorization should also use Clerk publicMetadata.role=admin.
VITE_ADMIN_EMAILS="rw@akaziconnect.com"

# Supabase Database & Realtime
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# WhatsApp Cloud API (SERVER ONLY — never prefix these with VITE_)
# Meta's send-message endpoint is /{Version}/{Phone-Number-ID}/messages.
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_ACCESS_TOKEN="YOUR_META_WHATSAPP_ACCESS_TOKEN"
WHATSAPP_PHONE_NUMBER_ID="YOUR_WHATSAPP_PHONE_NUMBER_ID"
# Admin WhatsApp number in international format, digits only.
WHATSAPP_ADMIN_NUMBER="221775784158"
