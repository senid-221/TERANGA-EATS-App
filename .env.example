# GEMINI_API_KEY: Required for Gemini AI API calls.
# Keep private; never expose server-only secrets with the VITE_ prefix.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

APP_URL="https://citymarketbusiness.com"
VITE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# Admin server-cookie authentication — SERVER ONLY.
ADMIN_EMAIL="rw@akaziconnect.com"
ADMIN_PASSWORD="YOUR_ADMIN_PASSWORD"
ADMIN_SESSION_SECRET="YOUR_LONG_RANDOM_SESSION_SECRET"

# Supabase client — safe for browser catalog reads.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Supabase server — SECRET, never prefix with VITE_.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# WasenderAPI WhatsApp — SERVER ONLY, never prefix with VITE_.
# Create/link the WhatsApp session in WasenderAPI and copy its API key.
WASENDER_API_KEY="YOUR_WASENDER_API_KEY"
WASENDER_ADMIN_NUMBER="+250726969060"
# Use the webhook secret shown/generated in WasenderAPI session webhook settings.
WASENDER_WEBHOOK_SECRET="YOUR_WASENDER_WEBHOOK_SECRET"
# Optional; defaults to the official WasenderAPI base URL.
WASENDER_API_URL="https://www.wasenderapi.com"
